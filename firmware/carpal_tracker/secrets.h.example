// secrets.h.example — これを secrets.h にコピーして実値を設定する (コミット禁止)
// MQTT 接続先・WiFi・SIM 情報をここに書く。

// ---- 接続経路: 0 = WiFi (ベンチ検証), 1 = LTE Cat-M (実車) ----
#define CARPAL_USE_LTE 1

// ---- WiFi (ベンチ検証用。2.4GHz のみ対応) ----
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// ---- MQTT (Mosquitto) ----
// [実車 LTE] SORACOM Beam MQTT エントリポイント経由。
// デバイスは beam.soracom.io:1883 に平文接続し、Beam が MQTTS で転送先へ繋ぐ
// (平文区間は Soracom 網内のみ。Soracom コンソールでの Beam 設定手順は
//  docs/operations-design.md §5.2)
#define MQTT_HOST "beam.soracom.io"
#define MQTT_PORT 1883
#define MQTT_USE_TLS 0
// [屋外 WiFi] TLS で公開ブローカーへ。外部ポート 62913 は MAP-E 割当範囲
// (5568+4096*A .. +15, A=1..15) 内。ルーターで 62913 → LXC 131:8883 に DNAT 済み。
//   #define MQTT_HOST "mqtt.takezou.com"
//   #define MQTT_PORT 62913
//   #define MQTT_USE_TLS 1
// [LAN ベンチ] 平文 1883 直結 (IP は環境に合わせて変更)
//   #define MQTT_HOST "192.168.x.x"
//   #define MQTT_PORT 1883
//   #define MQTT_USE_TLS 0
#define MQTT_USER "car01"           // ACL: 自トピックへの publish のみ許可
#define MQTT_PASS "__ デバイスAPIが発行したシークレットを貼り付け __"   // devices API が発行

// ---- 識別 (docs/contract.md) ----
#define CARPAL_TENANT_ID   "default"
#define CARPAL_DEVICE_ID   "car01"
#define CARPAL_DEVICE_SECRET "change-me"   // Phase 2 で devices.secret に統合

// ---- LTE (SORACOM Air plan-D: ドコモ網 LTE Cat.M1) ----
// 公式 APN 設定: https://users.soracom.io/ja-jp/docs/air/apn-settings/
#define APN "soracom.io"
#define APN_USER "sora"
#define APN_PASS "sora"
#define APN_USER "sora"
#define APN_PASS "sora"
