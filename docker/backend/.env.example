# docker/backend/.env.example — .env にコピーして実値を設定 (コミット禁止)
# 各値は `openssl rand -hex 16` などで生成した実値に置き換えること
PGPASSWORD=replace-me-with-generated-hex
# postgres ボリューム初回初期化用 (PGPASSWORD と同一値を設定)
POSTGRES_PASSWORD=replace-me-with-generated-hex
JWT_SECRET=replace-me-with-generated-hex
DYNSEC_ADMIN_PASSWORD=replace-me-with-generated-hex
MQTT_PASS=replace-me-with-generated-hex
ADMIN_PASSWORD=replace-me-with-generated-hex
# 過去資産移行用 (実機再構成後に削除)
LEGACY_MQTT_USERS=
