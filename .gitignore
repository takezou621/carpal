# Secrets / credentials (絶対にコミットしない)
docker/mosquitto/passwd
firmware/carpal_tracker/secrets.h
*.pem
*.key

# Local env files (認証情報は環境変数で管理)
.env*
!.env.example

# Node
node_modules/
npm-debug.log*

# Simulator logs
web/simulator/*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Backups / dumps (ダンプと明示的に分かるパターンのみ除外。正規 SQL は追跡)
*.dump
*dump.sql
*-backup.sql
*.sql.gz
mosquitto-data/

# ローカル設定 (MQTT 認証情報を含む — コミット禁止)
web/config.local.js

# AI agent local settings
.claude/settings.local.json

# backend credentials
docker/backend/.env

# Cloudflare Tunnel 認証情報 (トンネル秘密鍵を含む)
docker/caddy/cloudflared/*.json
